<% layout("/layouts/boilerplate")%>
<body>
    <br><br>
    <div class="row">
        <div class="col-8 offset-2">
    <h1>
        Add your listing
    </h1>
    <form method="post" action="/listings" enctype="multipart/form-data" class="needs-validation" novalidate>
        <div>
            <label for="title" class="form-label">Title</label>
            <input type="text" class="form-control"
             name="listing[title]"
              placeholder="enter title" required>
           <div class="valid-feedback">Title looks good!!</div>
        </div>
        
        <div>
            <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control"
         placeholder="enter description" required></textarea>
         <div class="invalid-feedback">Description should be short!!</div>
        </div>

        <div>
            <label for="price" class="form-label">Price</label>
        <input type="text" class="form-control" name="listing[price]" 
        placeholder="enter price" required>
        <div class="invalid-feedback">Price should be number</div>
        </div>

      <div class="row"> 
        <div class="mb-3 col-md-4">
            <label for="location" class="form-label">Location</label>
        <input type="text"  class="form-control" 
        name="listing[location]" placeholder="enter loaction" required>
        <div class="invalid-feedback">Please enter the Location!!</div>
        </div>

        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
        <input type="text"  class="form-control" 
        name="listing[country]" placeholder="enter country" required>
        <div class="invalid-feedback">Please Enter your country name</div>
        </div>
        </div>

      
        <div>
            <label for="image"
             class="form-label">Upload Listing Image</label>
        <input type="file" 
        class="form-control"
         name="listing[image]"
          placeholder="enter image url/link"
          required>
        </div>
        <br> <br>
        <button class="btn btn-dark add-btn">add</button>
    </form>
    </div>
    </div>
    <br><br>
</body>
