<% layout("/layouts/boilerplate")%>
<body>
  <br>
  <br>
  <div class="row ">
    <div class="col-8 offset-2">
  
  <h1>
    <%=listing.title%>
  </h1>
  </div>
  <div class="card col-6 offset-2" >
  <img src="<%= listing.image.url %>" 
     class="card-img-top show-img" 
     alt="listing_image">
  <div class="card-body">
    <p class="card-text">
      Owned By:<%=listing.owner.username%>
      </p>
     <p class="card-text"> <%=listing.description%></p>
      <p class="card-text"> &#8377;<%=listing.price.toLocaleString("en-IN")%></p>
       <p class="card-text"><%=listing.location%></p>
       <p class="card-text"><%=listing.country%></p>
    </p>
  </div>
</div>
  
  <br>
  <% if(currUser && currUser._id.equals(listing.owner._id)){%>
  <div class="show-btn offset-2">
  <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark add-btn">Edit</a>
  <form method="post" action="/listings/<%=listing._id%>?_method=delete">
    <button class="btn btn-dark add-btn offset-3">Delete</button>
  </form>
   </div>
  <%}%>
   <br>
   <br>
   <br>
  <hr class="offset-2">
 
   <div class=" col-8 mb-3 offset-2">
      <% if(currUser){%>
    <h4>Leave a Review</h4>
    <br>
    <form method="post" action="/listings/<%=listing.id%>/reviews" novalidate class="needs-validation">
      <!-- <div >
        <label for="rating" >rating</label>
        <input type="range"
         min="1"
        max="5"
         id="rating" 
         name="review[rating]"
         class="form-range">
      </div> -->
<div>
   <label for="rating" class="form-label">rating</label>
 <fieldset class="starability-slot">
  
 
  <input type="radio" 
  id="no-rate" 
  class="input-no-rate" 
  name="review[rating]" 
  value="1"
   checked 
   aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
      <br>

      <div>
        <label for="comment" class="form-label">Comments</label>
        <textarea id="comment" 
        name="review[comment]"
        cols="5"
        rows="10" 
        class="form-control" 
        required></textarea>
      <div class="invalid-feedback">
          please leave a comment
      </div>

      </div>
      <br>
      <div>
        <button class="btn btn-outline-dark">submit</button>
      </div>
    </form>
   </div>
  <%}%>
   <hr class="offset-2">
   <h2 class="offset-2">All reviews</h2>
   <div class="row offset-2">
  <% for(review of listing.reviews){%>
     <div class="card  col-5 ms-3 mb-2 card-review">
       <div class="card-body">
        <h5 class="card-title">@<%=review.author.username%></h5>
        <p class="starability-result
         card-title" data-rating="<%=review.rating%>">
        </p>
        <h5 class="card-title"><%=review.comment%></h5>
        <!-- <h5 class="card-title"><%=review.rating%> stars</h5> -->
        
       </div>
       <form class="mb-3" method="post" action="/listings/<%=listing.id%>/reviews/<%=review._id%>?_method=delete">
        <button class="btn btn-sm btn-dark">Delete</button>
       </form>
     </div>
   
   <%}%>
   </div>
  </div>
  
</body>
